@page
@model Web.Pages.ContentModel

<h2>@Model.Slot.Title</h2>
<p><strong>Category:</strong> @Model.Slot.Category</p>
<p><strong>Subcategory:</strong> @Model.Slot.SubCategory</p>
<p><strong>Description:</strong> @Model.Slot.Description</p>

<!-- Displaying Content for the Slot -->
<h3>Slot Content</h3>
<div>
    <p><strong>Lesson 1:</strong> Introduction to the Slot</p>
    <p><strong>Lesson 2:</strong> Overview of Key Concepts</p>
    <p><strong>Lesson 3:</strong> Deep Dive into Slot Topics</p>
    <!-- Add more content dynamically or statically based on the Slot data -->
</div>

@if (Model.Slot.IsBooked)
{
    <div class="alert alert-warning">
        <strong>This is a Premium Slot. Please ensure payment has been made to access full content.</strong>
    </div>
}
else
{
    <div class="alert alert-success">
        <strong>You can access all content for this Slot for free!</strong>
    </div>
}

@if (!Model.IsEnrolled)
{
    <a asp-page="/Payment" asp-route-SlotId="@Model.Slot.SlotId" class="btn btn-warning">Enroll to Access Premium Content</a>
}
else
{
    <button class="btn btn-success">Start Learning</button>
}
